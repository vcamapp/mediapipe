PACKAGE_VERSION="0.0.14"
PACKAGE_BUILD="1"
# Upstream MediaPipe source tag that every slice is built from, with the
# patches in source/patches (see source/README.md). The patches have to be
# rebased for each upstream release.
MEDIAPIPE_VERSION="1.2.0"
MINIMUM_IOS_VERSION="17.0"
MINIMUM_MACOS_VERSION="14.0"
# OpenCV statically linked into every static library (see source/README.md).
OPENCV_VERSION="4.13.0"
# Prebuilt static libraries, one zip per platform
# (MediaPipeTasksVision-<macos|ios|ios-simulator>-arm64-<MEDIAPIPE_VERSION>.zip)
# on the static-<MEDIAPIPE_VERSION> release. Set STATIC_ARTIFACT_DIR to a
# directory holding the three zips to use local builds instead of downloading.
STATIC_ARTIFACT_URL="https://github.com/vcamapp/mediapipe/releases/download/static-${MEDIAPIPE_VERSION}"
MACOS_ARTIFACT_SHA256="c084b389281e8a53421f781826c3a210280f1bdf9162912dfdf7c7dff2c0d700"
IOS_ARTIFACT_SHA256="d8b375f1ac21d41a1e1472cce9a457f1b5e85c466eecdded11bd2d185abade01"
IOS_SIMULATOR_ARTIFACT_SHA256="6048435eee99c3711e1b9abd110e7826105e1672c88f1c124db8d7b4fcbc416b"
# Objective-C classes that every released binary (iOS and macOS) must export.
# Consumed by scripts/validate.sh and source/build-static-lib.sh.
REQUIRED_OBJC_CLASSES="MPPFaceLandmarker MPPGestureRecognizer MPPHandLandmarker MPPHolisticLandmarker MPPPoseLandmarker"
