 #if TARGET_OS_OSX
+  // VCam: unlike the iOS ES variant, CVOpenGLTextureCache does not recycle
+  // unused entries on create, and nothing else flushes it outside the pixel
+  // buffer pool path, which the ImageFrame conversion path never uses. The
+  // per-frame textures therefore pile up together with their backing
+  // IOSurfaces until CVPixelBufferCreate fails with
+  // kCVReturnAllocationFailed (-6662) and MediaPipe aborts. Flushing releases
+  // only entries whose CVOpenGLTextureRef is no longer retained, so views
+  // still held by in-flight GlTextureViews are unaffected.
+  CVOpenGLTextureCacheFlush(gl_context->cv_texture_cache(), 0);
