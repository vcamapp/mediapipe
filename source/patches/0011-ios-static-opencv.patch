diff --git a/third_party/opencv_ios_static.BUILD b/third_party/opencv_ios_static.BUILD
new file mode 100644
index 0000000..db626c2
--- /dev/null
+++ b/third_party/opencv_ios_static.BUILD
@@ -0,0 +1,27 @@
+# Description:
+#   Statically linked OpenCV libraries for iOS (device or simulator, whichever
+#   the referencing repository points at). Built like the macOS prefix
+#   (opencv_macos.BUILD) with BUILD_SHARED_LIBS=OFF,
+#   BUILD_LIST=core,imgcodecs,imgproc and BUILD_ZLIB=OFF.
+
+licenses(["notice"])  # Apache 2.0
+
+exports_files(["LICENSE"])
+
+cc_library(
+    name = "opencv",
+    srcs = glob([
+        "lib/libopencv_core.a",
+        "lib/libopencv_imgproc.a",
+        "lib/libopencv_imgcodecs.a",
+        "lib/opencv4/3rdparty/*.a",
+    ]),
+    hdrs = glob(["include/opencv4/opencv2/**/*.h*"]),
+    includes = ["include/opencv4/"],
+    linkopts = [
+        "-framework Accelerate",
+        "-lz",
+    ],
+    linkstatic = 1,
+    visibility = ["//visibility:public"],
+)
