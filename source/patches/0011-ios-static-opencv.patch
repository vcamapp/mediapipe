+# VCam: statically built OpenCV install prefixes for the iOS device and
+# simulator builds (source/build-opencv.sh in the distribution repository).
+# They replace @ios_opencv_source, whose OpenCV 4.5.3 framework build no longer
+# configures with current Xcode and CMake.
+new_local_repository(
+    name = "ios_opencv_static",
+    build_file = "@//third_party:opencv_ios_static.BUILD",
+    path = "third_party/opencv_ios_static",
+)
+
+new_local_repository(
+    name = "ios_simulator_opencv_static",
+    build_file = "@//third_party:opencv_ios_static.BUILD",
+    path = "third_party/opencv_ios_simulator_static",
+)
+
