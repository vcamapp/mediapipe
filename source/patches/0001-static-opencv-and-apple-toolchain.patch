diff --git a/.bazelrc b/.bazelrc
index d8e4709..6630a50 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -132,6 +132,17 @@ build:darwin_arm64 --apple_platform_type=macos
 build:darwin_arm64 --macos_minimum_os=10.16
 build:darwin_arm64 --cpu=darwin_arm64
 
+# Required for the macOS static library build (see source/README.md in the
+# distribution repository):
+# - TensorFlow's hermetic Python needs a version with a requirements lock;
+#   the interpreter is downloaded, so the host Python version is irrelevant.
+# - Bazel 7 removed its builtin Apple C++ toolchain; objc_library requires
+#   the apple_support crosstool.
+common --repo_env=HERMETIC_PYTHON_VERSION=3.12
+build:macos --apple_crosstool_top=@local_config_apple_cc//:toolchain
+build:macos --crosstool_top=@local_config_apple_cc//:toolchain
+build:macos --host_crosstool_top=@local_config_apple_cc//:toolchain
+
 # Turn off maximum stdout size
 build --experimental_ui_max_stdouterr_bytes=-1
 
diff --git a/MODULE.bazel b/MODULE.bazel
index a0111fe..8e3accb 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -94,3 +94,7 @@ node.toolchain(node_version = "20.14.0")
 use_repo(node, "nodejs_toolchains")
 
 register_toolchains("@nodejs_toolchains//:all")
+# Expose apple_support's configured CC toolchain repo to the root module so
+# the --crosstool_top flags in .bazelrc (macOS static library build) resolve.
+apple_cc_configure = use_extension("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
+use_repo(apple_cc_configure, "local_config_apple_cc")
