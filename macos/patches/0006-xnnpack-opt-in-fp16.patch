diff --git a/WORKSPACE b/WORKSPACE
index 0d40e1697..14fd21f16 100644
--- a/WORKSPACE
+++ b/WORKSPACE
@@ -258,6 +258,8 @@ http_archive(
         # See https://github.com/bazelbuild/bazel/issues/19912
         "@//third_party:org_tensorflow_objc_build_fixes.diff",
         "@//third_party:org_tensorflow_verifier_int4.diff",
+        # VCam: opt-in FP16 inference for the XNNPACK delegate.
+        "@//third_party:org_tensorflow_xnnpack_fp16.diff",
     ],
     sha256 = _TENSORFLOW_SHA256,
     strip_prefix = "tensorflow-%s" % _TENSORFLOW_GIT_COMMIT,
diff --git a/third_party/org_tensorflow_xnnpack_fp16.diff b/third_party/org_tensorflow_xnnpack_fp16.diff
new file mode 100644
index 000000000..c869dfca9
--- /dev/null
+++ b/third_party/org_tensorflow_xnnpack_fp16.diff
@@ -0,0 +1,15 @@
+--- a/tensorflow/lite/delegates/xnnpack/xnnpack_delegate.cc
++++ b/tensorflow/lite/delegates/xnnpack/xnnpack_delegate.cc
+@@ -7253,5 +7253,12 @@
+   options.flags |= TFLITE_XNNPACK_DELEGATE_FLAG_DYNAMIC_FULLY_CONNECTED;
+ #endif  // XNNPACK_DELEGATE_TEST_MODE
+   options.weight_cache_file_descriptor = -1;
++  // VCam: FP16 inference, opted into per delegate through the environment.
++  // Forcing it for every model is not safe: the pose detector stops producing
++  // any detection in FP16, while hand landmarks stay within ~1% drift.
++  const char* force_fp16 = std::getenv("MEDIAPIPE_XNNPACK_FORCE_FP16");
++  if (force_fp16 != nullptr && force_fp16[0] == '1') {
++    options.flags |= TFLITE_XNNPACK_DELEGATE_FLAG_FORCE_FP16;
++  }
+   return options;
+ }
