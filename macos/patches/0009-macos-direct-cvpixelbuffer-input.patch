+
+// VCam: a BGRA `CVPixelBuffer` goes into the graph as a `GpuBuffer` wrapping the
+// buffer itself instead of being copied into an `ImageFrame`. The copy permutes
+// the channels and unpremultiplies the alpha on the CPU, and the graph's
+// `ImageCloneCalculator` then copies it back into a fresh `CVPixelBuffer` to
+// upload it; for an opaque camera frame that is ~40% of the task's CPU time
+// spent on a round trip that changes nothing (unpremultiplying alpha 255 is the
+// identity). The pixel buffer must be IOSurface-backed, as camera frames and
+// pool buffers created with `kCVPixelBufferIOSurfacePropertiesKey` are. Other
+// pixel formats keep the `ImageFrame` path.
+std::optional<Image> ImageFromMPPImage(MPPImage *image, NSError **error) {
+#if !MEDIAPIPE_DISABLE_GPU && MEDIAPIPE_GPU_BUFFER_USE_CV_PIXEL_BUFFER
+  CVPixelBufferRef pixelBuffer = nullptr;
+  switch (image.imageSourceType) {
+    case MPPImageSourceTypePixelBuffer:
+      pixelBuffer = image.pixelBuffer;
+      break;
+    case MPPImageSourceTypeSampleBuffer:
+      pixelBuffer = CMSampleBufferGetImageBuffer(image.sampleBuffer);
+      break;
+    default:
+      break;
+  }
+  if (pixelBuffer && CVPixelBufferGetPixelFormatType(pixelBuffer) == kCVPixelFormatType_32BGRA &&
+      CVPixelBufferGetIOSurface(pixelBuffer)) {
+    return Image(pixelBuffer);
+  }
+#endif  // !MEDIAPIPE_DISABLE_GPU && MEDIAPIPE_GPU_BUFFER_USE_CV_PIXEL_BUFFER
+  std::unique_ptr<ImageFrame> imageFrame = [image imageFrameWithError:error];
+  if (!imageFrame) {
+    return std::nullopt;
+  }
+  return Image(std::move(imageFrame));
+}
 }  // namespace
 
