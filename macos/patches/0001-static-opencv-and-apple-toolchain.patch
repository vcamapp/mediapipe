 bazel_dep(name = "rules_swift", version = "2.3.0", repo_name = "build_bazel_rules_swift")
 bazel_dep(name = "rules_proto_grpc_js", version = "5.8.0")
 bazel_dep(name = "rules_rust", version = "0.46.0")
@@ -89,3 +92,7 @@ node.toolchain(node_version = "20.14.0")
 use_repo(node, "nodejs_toolchains")
 
 register_toolchains("@nodejs_toolchains//:all")
+# Expose apple_support's configured CC toolchain repo to the root module so
+# the --crosstool_top flags in .bazelrc (macOS static library build) resolve.
+apple_cc_configure = use_extension("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
+use_repo(apple_cc_configure, "local_config_apple_cc")
